# Every secret the ontic-pages deploy needs. Copy to deploy/secrets.env,
# chmod 600, fill in. deploy/deploy.sh copies it to the box and pages.sh turns
# it into /etc/ontic-pages/gateway.env and /etc/ontic-pages/oauth2-proxy.cfg.
# NEVER COMMIT THE FILLED FILE (it is gitignored); keep it in the password manager.
# Plain KEY=VALUE lines, no quotes needed, no spaces around '='.

# 1. Google sign-in: a "Web application" OAuth client (the team's existing one
#    is fine) listing https://pages.onticlabs.io/oauth2/callback as an
#    authorized redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate once: openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_COOKIE_SECRET=
OAUTH2_EMAIL_DOMAIN=onticlabs.io

# 2. The bucket, READ and WRITE but no delete: a key scoped to the ontic-pages bucket with
#    listBuckets,listFiles,readFiles,writeFiles (the ontic-pages-publish key has exactly
#    that, see deploy/README.md). The gateway is the only holder of a bucket key: it writes
#    page.json, current and visibility, and hands out presigned PUT URLs for the files.
#    Pages sit at the bucket root; ONTIC_PAGES_PREFIX stays empty unless you use one.
ONTIC_PAGES_BUCKET=ontic-pages
ONTIC_PAGES_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
ONTIC_PAGES_REGION=eu-central-003
ONTIC_PAGES_PREFIX=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 3. Command line sign-in: the gateway signs each person's 30-day token with this
#    (ontic-pages login). Generate once: openssl rand -base64 32
#    Changing it signs everyone out (they run ontic-pages login again).
ONTIC_PAGES_TOKEN_SECRET=

# 4. Optional: keep the milestones in step with the GitHub milestones of a repository
#    (github.py). A fine-grained token, resource owner onticlabs, only the repository below,
#    permission Issues: read and write (milestones belong to issues). Leave the token empty
#    for no sync. OWNER: the email that owns milestones made on GitHub without one.
ONTIC_PAGES_GITHUB_TOKEN=
ONTIC_PAGES_GITHUB_REPO=onticlabs/experiments
ONTIC_PAGES_GITHUB_OWNER=
