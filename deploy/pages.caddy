# ontic-pages: the bar at https://pages.onticlabs.io/<name>/, each page's content at
# https://<name>.pages.onticlabs.io/
#
#   pages.onticlabs.io/oauth2/*   caddy :443 -> pages-oauth2-proxy 127.0.0.1:4190  (Google sign-in)
#   pages.onticlabs.io/*          caddy :443 -> pages-gateway 127.0.0.1:8790       (listing, bar, API)
#   *.pages.onticlabs.io/*        caddy :443 -> pages-gateway 127.0.0.1:8790       (page content)
#
# Install as /etc/caddy/conf.d/pages.caddy (the main Caddyfile imports conf.d/*.caddy).
#
# ONE GLOBAL OPTION LIVES OUTSIDE THIS FILE. Certificates for *.pages.onticlabs.io are issued
# on demand, one per page on its first visit, and Caddy first asks the gateway whether that
# page exists. That needs, in the global options block of /etc/caddy/Caddyfile:
#
#     {
#         on_demand_tls {
#             ask http://127.0.0.1:8790/_tls-ask
#         }
#     }
#
# deploy/pages.sh refuses to install without it (deploy/README.md has the command).
#
# The gateway asks oauth2-proxy who a cookie belongs to (/oauth2/auth) and never reads identity
# headers from a request. Caddy strips them anyway, so that stays true for any upstream.
(pages_strip_identity) {
	header_up -X-Forwarded-Email
	header_up -X-Forwarded-User
	header_up -X-Forwarded-Groups
	header_up -X-Forwarded-Preferred-Username
	header_up -X-Forwarded-Access-Token
	header_up -X-Auth-Request-Email
	header_up -X-Auth-Request-User
	header_up -X-Auth-Request-Groups
	header_up -X-Auth-Request-Preferred-Username
	header_up -X-Auth-Request-Access-Token
}

pages.onticlabs.io {
	encode zstd gzip

	# The only writes are small JSON bodies to the API.
	request_body {
		max_size 64KB
	}

	# Only for Caddy itself, on 127.0.0.1: it says which page names exist.
	handle /_tls-ask {
		respond 404
	}

	handle /oauth2/* {
		reverse_proxy 127.0.0.1:4190 {
			import pages_strip_identity
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8790 {
			flush_interval -1
			import pages_strip_identity
		}
	}

	log {
		output stderr
		# Signed download URLs are bearer credentials; never log redirect targets.
		format filter {
			wrap json
			fields {
				resp_headers>Location delete
			}
		}
	}
}

# Every page, one certificate each, issued on its first visit once the gateway said the page
# exists. Caddy keeps the browser's Host header, which is how the gateway knows the page.
# Read-only: the gateway answers 405 to any write here.
*.pages.onticlabs.io {
	tls {
		on_demand
	}

	encode zstd gzip

	request_body {
		max_size 64KB
	}

	handle /_tls-ask {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:8790 {
			flush_interval -1
			import pages_strip_identity
		}
	}

	log {
		output stderr
		# Signed download URLs are bearer credentials; never log redirect targets.
		format filter {
			wrap json
			fields {
				resp_headers>Location delete
			}
		}
	}
}
